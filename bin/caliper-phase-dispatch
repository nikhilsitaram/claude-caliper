#!/usr/bin/env bash
set -euo pipefail

# caliper-phase-dispatch <plan.json> <parent-worktree> <task-id>
#
# Orchestrate's per-task dispatch in one call (issue #321): add the task's
# worktree nested under <parent-worktree> at .claude/worktrees/<task_lower> on a
# new branch <task_lower> forked from the parent's HEAD, seed agent memory into
# it, build its own Python .venv when the parent has one (issue #337), then
# claim the task in_progress. On success stdout is exactly one line — the task
# worktree's absolute path — and git/installer/validate-plan chatter goes to
# stderr. Under worktree isolation the lead can't loop over task ids or chain
# calls across two phase worktrees, so the steps are bundled into one call per
# task.
#
# <parent-worktree> is the feature worktree (single-phase plan) or the task's
# own phase worktree, on branch phase-<letter_lower> (multi-phase plan). Refused:
# the main checkout (sibling task worktrees there get silent permission denials
# in background subagents), a path that isn't a worktree root, a detached
# parent, a parent on another phase's branch, a task that isn't `pending`
# (`--ready` lists only pending tasks; re-dispatching an in_progress or
# complete task would double-run it), and a task whose branch or worktree
# directory already exists (stranded work — settle it per Resuming In-Flight
# Tasks in skills/orchestrate/dispatch-subagents.md; this never re-attaches).
#
# Order is add -> seed -> venv -> claim. The claim is the only step --ready sees, so it
# goes last: any failure before it leaves the task `pending` and rolls back the
# worktree and branch this run created (nothing pre-existing is touched). A hard
# kill between add and claim leaves "pending with a branch", which Resuming
# already settles; claim-first would strand "in_progress with no branch", which
# --ready never re-lists.

usage() {
  echo "Usage: caliper-phase-dispatch <plan.json> <parent-worktree> <task-id>" >&2
  exit 1
}
die() { echo "ERROR: $*" >&2; exit 1; }

# Called from a git hook, these would point every `git -C <parent>` below at the
# hook's repository instead.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR \
  GIT_NAMESPACE GIT_PREFIX GIT_ALTERNATE_OBJECT_DIRECTORIES

[[ $# -eq 3 ]] || usage
PLAN_JSON="$1" PARENT_ARG="$2" TASK_ID="$3"
BIN_DIR="$(dirname "$0")"

[[ -f "$PLAN_JSON" ]] || die "plan not found: $PLAN_JSON"
[[ -d "$PARENT_ARG" ]] || die "parent worktree does not exist: $PARENT_ARG"

TASK_INFO="$(jq -r --arg id "$TASK_ID" '
  [.phases[] | .letter as $l | .tasks[] | select(.id == $id) | "\($l) \(.status)"][0] // empty
' "$PLAN_JSON")" || die "can't read plan: $PLAN_JSON"
[[ -n "$TASK_INFO" ]] || die "task_not_found: '$TASK_ID' not found in plan"
read -r LETTER STATUS <<<"$TASK_INFO"
[[ "$STATUS" == "pending" ]] \
  || die "task $TASK_ID is '$STATUS', not pending — only pending tasks are dispatched (settle in-flight ones per Resuming In-Flight Tasks)"
PHASE_COUNT="$(jq '.phases | length' "$PLAN_JSON")"

# Parent: a linked worktree's root, never the main checkout.
REV="$(git -C "$PARENT_ARG" rev-parse --path-format=absolute --show-toplevel --git-dir --git-common-dir)" \
  || die "not a git worktree: $PARENT_ARG"
{ read -r PARENT; read -r WT_GITDIR; read -r COMMON_DIR; } <<<"$REV"
[[ "$(cd "$PARENT_ARG" && pwd -P)" == "$(cd "$PARENT" && pwd -P)" ]] \
  || die "not a worktree root: $PARENT_ARG (its root is $PARENT)"
[[ "$(cd "$WT_GITDIR" && pwd -P)" != "$(cd "$COMMON_DIR" && pwd -P)" ]] \
  || die "$PARENT is the main checkout — dispatch from the feature or phase worktree, or task worktrees land as siblings that background subagents can't write"

PARENT_BRANCH="$(git -C "$PARENT" rev-parse --abbrev-ref HEAD)"
[[ "$PARENT_BRANCH" != "HEAD" ]] || die "parent worktree $PARENT has a detached HEAD — task branches merge into the parent's branch"
if (( PHASE_COUNT > 1 )); then
  WANT="phase-$(tr '[:upper:]' '[:lower:]' <<<"$LETTER")"
  [[ "$PARENT_BRANCH" == "$WANT" ]] \
    || die "task $TASK_ID belongs to phase $LETTER: dispatch it from the $WANT worktree, not $PARENT (on $PARENT_BRANCH)"
fi

BRANCH="$(tr '[:upper:]' '[:lower:]' <<<"$TASK_ID")"
git check-ref-format "refs/heads/$BRANCH" || die "task id '$TASK_ID' isn't a valid branch name"
TASK_WORKTREE="$PARENT/.claude/worktrees/$BRANCH"
if git -C "$PARENT" rev-parse --verify --quiet "refs/heads/$BRANCH" >/dev/null; then
  die "branch $BRANCH already exists — settle it per Resuming In-Flight Tasks before re-dispatching"
fi
[[ ! -e "$TASK_WORKTREE" ]] \
  || die "$TASK_WORKTREE already exists — settle it per Resuming In-Flight Tasks before re-dispatching"

FORK_SHA="$(git -C "$PARENT" rev-parse HEAD)"
CREATED=0
# Undo only what this run made. Creating the branch on its own first makes it
# the lock: a concurrent run for the same task fails there with CREATED=0 and
# touches nothing, so once CREATED=1 anything at TASK_WORKTREE is ours — even
# from a `worktree add` that registered the worktree and then failed (e.g. a
# failing post-checkout hook). The worktree holds only the seeded memory copy,
# which clear-worktree-scratch removes (it's untracked where .claude/ isn't
# ignored, and would block the bare remove), and possibly a .venv, which
# caliper-python-bootstrap makes ignore itself so the bare remove deletes it.
# The branch delete names FORK_SHA as the expected old value, so it can't drop
# commits. If the claim's plan.json write landed before validate-plan failed,
# nothing is undone: the task is in_progress with a branch, which Resuming
# settles.
rollback() {
  (( CREATED )) || return 0
  if [[ "$(jq -r --arg id "$TASK_ID" '.phases[].tasks[] | select(.id == $id) | .status' "$PLAN_JSON")" != "pending" ]]; then
    echo "ERROR: validate-plan failed after claiming $TASK_ID; $TASK_WORKTREE kept — settle per Resuming In-Flight Tasks" >&2
    return 0
  fi
  if { [[ ! -e "$TASK_WORKTREE" ]] \
        || { "$BIN_DIR/clear-worktree-scratch" "$TASK_WORKTREE" >&2 \
             && git -C "$PARENT" worktree remove "$TASK_WORKTREE" >&2; }; } \
      && git -C "$PARENT" update-ref -d "refs/heads/$BRANCH" "$FORK_SHA"; then
    echo "Rolled back $TASK_WORKTREE; task $TASK_ID left pending" >&2
  else
    echo "ERROR: rollback incomplete: $TASK_WORKTREE / branch $BRANCH remain; task $TASK_ID is pending — settle per Resuming In-Flight Tasks" >&2
  fi
}
trap rollback EXIT

git -C "$PARENT" branch "$BRANCH" "$FORK_SHA"
CREATED=1
git -C "$PARENT" worktree add "$TASK_WORKTREE" "$BRANCH" >&2
"$BIN_DIR/seed-agent-memory" "$TASK_WORKTREE" >&2
# The task can't share the parent's .venv: its editable install imports the
# parent's source. --like builds the task its own only when the parent has one.
"$BIN_DIR/caliper-python-bootstrap" --like "$PARENT" "$TASK_WORKTREE" >&2
"$BIN_DIR/validate-plan" --update-status "$PLAN_JSON" --task "$TASK_ID" --status in_progress >&2
CREATED=0
trap - EXIT

echo "$TASK_WORKTREE"
