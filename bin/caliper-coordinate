#!/usr/bin/env bash
# shellcheck disable=SC2016  # jq filters are single-quoted on purpose: their $vars are jq variables
set -euo pipefail

# caliper-coordinate [--ledger PATH] <command> ...
#
# The coordinate skill's ledger (gh #319): one JSON file per repo at
# <main checkout>/.claude/claude-caliper/coordinate.json, so the train survives
# compaction and a new session. Only this CLI writes it — Write prompts on every
# .claude/ path, and hand-edited JSON drifts. --ledger overrides the path.
#
# Commands:
#   add <slug> [--issue N] [--after a,b,...] [--soft-after a,b,...]   queue an item
#   set <slug> [--status S] [--issue N] [--after a,b] [--soft-after a,b]
#              [--pane-name X] [--session-id ID] [--pr N] [--head SHA]
#              [--hold REASON] [--unhold]
#   get <slug>                    print one item (JSON)
#   list [--status S]             print items (JSON array)
#   ready                         slugs of queued, unheld items whose deps merged
#   active                        how many items hold an open pane
#   status                        reconcile with live gh, then print a table
#
# Statuses run queued -> running -> at-bar -> merged -> done; dropped abandons an
# item. Held is a flag with reasons, beside the status. An --after entry is
# another item's slug (met once that item is merged or done) or pr:N for a PR
# outside the ledger (met once gh reports it MERGED). A --soft-after entry (gh
# #329) is another item's slug only: the dependent may start at once, building
# against what it anticipates from that item, and rebases once it merges. `ready`
# ignores soft deps unless one was dropped; `status` shows each unmerged one as
# `<slug> (soft)` in WAITING ON. A slug can't be both a hard and a soft dep of
# the same item, and add/set refuse a cycle through either kind. `status`
# re-adds a dropped-dependency hold after --unhold until the dependency list is
# edited. `active` counts running,
# at-bar and merged items: a merged item's pane stays open until its cleanup
# report, when the coordinator closes it and sets done. `status` moves an item
# whose PR GitHub reports MERGED to merged, so merges done outside the
# coordinator (by the user, in a pane) aren't missed. It also holds what would
# otherwise stall silently: an item whose PR was closed without merging, and a
# queued item that depends on a dropped item or on a pr:N closed unmerged (it
# can never become ready), and a queued, running or at-bar item whose soft dep
# was dropped (what it builds against will never land). Each item it moves to merged is printed as a
# `MERGED-ON-GITHUB <slug>` line before the table, so the coordinator can run
# its after-merge steps for it.
# --session-id takes the SESSION_ID= spawn-pane.sh prints.
#
# Exit: 0 ok, 1 a state error (unknown or duplicate slug, bad dependency),
# 64 usage error.

STATUSES="queued running at-bar merged done dropped"

usage() {
  echo "Usage: caliper-coordinate [--ledger PATH] add|set|get|list|ready|active|status ..." >&2
  [[ -z "${1:-}" ]] || echo "caliper-coordinate: $1" >&2
  exit 64
}
die() { echo "caliper-coordinate: $1" >&2; exit 1; }

LEDGER=""
if [[ "${1:-}" == --ledger ]]; then
  [[ $# -ge 2 ]] || usage "--ledger needs a path"
  LEDGER="$2"; shift 2
fi
if [[ -z "$LEDGER" ]]; then
  LEDGER="$("$(dirname "$0")/caliper-main-root")/.claude/claude-caliper/coordinate.json"
fi
CMD="${1:-}"; [[ -n "$CMD" ]] || usage; shift

now() { date -u +%Y-%m-%dT%H:%M:%SZ; }
load() { [[ -f "$LEDGER" ]] && cat "$LEDGER" || echo '{"version": 1, "items": []}'; }
save() {  # <json> — atomic replace in the ledger's own dir
  mkdir -p "$(dirname "$LEDGER")"
  local tmp; tmp="$(mktemp "$LEDGER.XXXXXX")"
  printf '%s\n' "$1" > "$tmp" && mv "$tmp" "$LEDGER"
}
valid_slug() { [[ "$1" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]] || usage "slug '$1' must be letters, digits, dot, underscore, dash"; }
valid_status() { [[ " $STATUSES " == *" $1 "* ]] || usage "status '$1' is not one of: $STATUSES"; }
valid_int() { [[ "$2" =~ ^[0-9]+$ ]] || usage "$1 needs a number, got '$2'"; }
has_item() { jq -e --arg s "$2" 'any(.items[]; .slug == $s)' <<<"$1" >/dev/null; }

after_json() {  # <ledger-json> <slug> <comma-list> [--soft-after] -> JSON array, validated
  local json="$1" self="$2" list="$3" flag="${4:---after}" a out='[]'
  # An empty list leaves `parts` empty, and "${parts[@]}" on an empty array
  # trips `set -u` in bash 3.2 (stock macOS).
  [[ -n "$list" ]] || { echo '[]'; return; }
  IFS=',' read -ra parts <<<"$list"
  for a in "${parts[@]}"; do
    [[ -n "$a" ]] || continue
    if [[ "$a" =~ ^pr:[0-9]+$ ]]; then
      # A soft dep is built against its item's approved scope, and only ledger
      # merges send the after-merge message, so an outside PR has no soft form.
      [[ "$flag" == --after ]] || usage "--soft-after takes item slugs only, not '$a'"
    else
      [[ "$a" != "$self" ]] || die "$self can't depend on itself"
      has_item "$json" "$a" || die "$flag '$a' is not an item in the ledger$([[ "$flag" == --after ]] && echo ' (or pr:N)')"
    fi
    out="$(jq -c --arg a "$a" '. + [$a]' <<<"$out")"
  done
  echo "$out"
}

check_deps() {  # <ledger-json> <slug>: refuse a slug both hard and soft, and any cycle
  local both
  both="$(jq -r --arg s "$2" '.items[] | select(.slug == $s)
    | (.soft_after // []) as $soft | [.after[] | select(IN($soft[]))] | join(",")' <<<"$1")"
  [[ -z "$both" ]] || die "$2: '$both' can't be both --after and --soft-after"
  # Hard or soft, a cycle deadlocks: each end waits for the other to merge.
  jq -e --arg s "$2" '. as $l
    | def deps($x): [$l.items[] | select(.slug == $x)
        | (.after[] | select(startswith("pr:") | not)), (.soft_after // [])[]];
    {seen: [], todo: deps($s)}
    | until(.todo | length == 0;
        .todo[0] as $x | .todo |= .[1:]
        | if any(.seen[]; . == $x) then . else .seen += [$x] | .todo += deps($x) end)
    | any(.seen[]; . == $s) | not' <<<"$1" >/dev/null \
    || die "$2: that dependency would make a cycle back to $2"
}

hold_once() {  # <ledger-json> <slug> <reason> -> ledger with the hold added once
  jq --arg s "$2" --arg r "$3" --arg t "$(now)" '(.items[] | select(.slug == $s))
    |= if (.hold_reasons | index($r)) then . else (.held = true | .hold_reasons += [$r] | .updated_at = $t) end' <<<"$1"
}

pr_state() {  # <n> -> OPEN|MERGED|CLOSED, or UNKNOWN when gh can't read it
  local v
  v="$(gh pr view "$1" --json state 2>/dev/null)" && jq -r '.state // "UNKNOWN"' <<<"$v" || echo UNKNOWN
}

case "$CMD" in
  add)
    SLUG="${1:-}"; [[ -n "$SLUG" ]] || usage "add needs a slug"; shift
    valid_slug "$SLUG"
    ISSUE=null AFTER="" SOFT=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --issue) [[ $# -ge 2 ]] || usage; valid_int --issue "$2"; ISSUE="$2"; shift 2 ;;
        --after) [[ $# -ge 2 ]] || usage; AFTER="$2"; shift 2 ;;
        --soft-after) [[ $# -ge 2 ]] || usage; SOFT="$2"; shift 2 ;;
        *) usage "unknown add option '$1'" ;;
      esac
    done
    J="$(load)"
    ! has_item "$J" "$SLUG" || die "item '$SLUG' already exists"
    A="$(after_json "$J" "$SLUG" "$AFTER")"
    SA="$(after_json "$J" "$SLUG" "$SOFT" --soft-after)"
    J="$(jq --arg s "$SLUG" --argjson i "$ISSUE" --argjson a "$A" --argjson sa "$SA" --arg t "$(now)" '
      .items += [{slug: $s, issue: $i, status: "queued", held: false, hold_reasons: [],
                  after: $a, soft_after: $sa, pane: {name: null, session_id: null},
                  pr: {number: null, head: null}, created_at: $t, updated_at: $t,
                  merged_at: null}]' <<<"$J")"
    check_deps "$J" "$SLUG"
    save "$J"
    ;;

  set)
    SLUG="${1:-}"; [[ -n "$SLUG" ]] || usage "set needs a slug"; shift
    J="$(load)"
    has_item "$J" "$SLUG" || die "no item '$SLUG'"
    F='.'
    ARGS=(--arg s "$SLUG" --arg t "$(now)")
    while [[ $# -gt 0 ]]; do
      [[ "$1" == --unhold || $# -ge 2 ]] || usage "$1 needs a value"
      case "$1" in
        --status) valid_status "$2"; ARGS+=(--arg st "$2")
                  F+=' | .status = $st | if $st == "merged" and .merged_at == null then .merged_at = $t else . end' ;;
        --issue) valid_int --issue "$2"; ARGS+=(--argjson iss "$2"); F+=' | .issue = $iss' ;;
        --after) ARGS+=(--argjson af "$(after_json "$J" "$SLUG" "$2")"); F+=' | .after = $af' ;;
        --soft-after) ARGS+=(--argjson saf "$(after_json "$J" "$SLUG" "$2" --soft-after)"); F+=' | .soft_after = $saf' ;;
        --pane-name) ARGS+=(--arg pn "$2"); F+=' | .pane.name = $pn' ;;
        --session-id) ARGS+=(--arg sid "$2"); F+=' | .pane.session_id = $sid' ;;
        --pr) valid_int --pr "$2"; ARGS+=(--argjson prn "$2"); F+=' | .pr.number = $prn' ;;
        --head) ARGS+=(--arg hd "$2"); F+=' | .pr.head = $hd' ;;
        --hold) ARGS+=(--arg hr "$2"); F+=' | .held = true | .hold_reasons += [$hr]' ;;
        --unhold) F+=' | .held = false | .hold_reasons = []'; shift; continue ;;
        *) usage "unknown set option '$1'" ;;
      esac
      shift 2
    done
    J="$(jq "${ARGS[@]}" "(.items[] | select(.slug == \$s)) |= ($F | .updated_at = \$t)" <<<"$J")"
    check_deps "$J" "$SLUG"
    save "$J"
    ;;

  get)
    [[ $# -eq 1 ]] || usage "get needs one slug"
    J="$(load)"
    has_item "$J" "$1" || die "no item '$1'"
    jq --arg s "$1" '.items[] | select(.slug == $s)' <<<"$J"
    ;;

  list)
    if [[ $# -gt 0 ]]; then
      [[ "$1" == --status && $# -eq 2 ]] || usage "list takes only --status S"
      valid_status "$2"
      load | jq --arg st "$2" '[.items[] | select(.status == $st)]'
    else
      load | jq '.items'
    fi
    ;;

  ready)
    J="$(load)"
    # Outside PRs named by any queued item, resolved once each.
    MERGED_PRS='[]'
    for p in $(jq -r '[.items[] | select(.status == "queued") | .after[] | select(startswith("pr:"))] | unique[]' <<<"$J"); do
      [[ "$(pr_state "${p#pr:}")" == MERGED ]] && MERGED_PRS="$(jq -c --arg p "$p" '. + [$p]' <<<"$MERGED_PRS")"
    done
    jq -r --argjson mp "$MERGED_PRS" '
      ([.items[] | select(.status == "merged" or .status == "done") | .slug] + $mp) as $met
      | [.items[] | select(.status == "dropped") | .slug] as $dropped
      | .items[] | select(.status == "queued" and (.held | not))
      | select(all(.after[]; IN($met[])))
      | select(any((.soft_after // [])[]; IN($dropped[])) | not)
      | .slug' <<<"$J"
    ;;

  active)
    load | jq '[.items[] | select(.status | IN("running", "at-bar", "merged"))] | length'
    ;;

  status)
    J="$(load)"
    for row in $(jq -r '.items[] | select((.status | IN("running", "at-bar")) and .pr.number != null) | "\(.slug):\(.pr.number)"' <<<"$J"); do
      case "$(pr_state "${row#*:}")" in
        MERGED) J="$(jq --arg s "${row%%:*}" --arg t "$(now)" \
          '(.items[] | select(.slug == $s)) |= (.status = "merged" | .merged_at //= $t | .updated_at = $t)' <<<"$J")"
                echo "MERGED-ON-GITHUB ${row%%:*}" ;;
        CLOSED) J="$(hold_once "$J" "${row%%:*}" "PR #${row#*:} closed without merging")" ;;
      esac
    done
    for row in $(jq -r '([.items[] | select(.status == "dropped") | .slug]) as $d
        | .items[] | select(.status == "queued") | .slug as $s
        | .after[] | select(IN($d[])) | "\($s):\(.)"' <<<"$J"); do
      J="$(hold_once "$J" "${row%%:*}" "depends on dropped item ${row#*:}")"
    done
    for row in $(jq -r '([.items[] | select(.status == "dropped") | .slug]) as $d
        | .items[] | select(.status | IN("queued", "running", "at-bar")) | .slug as $s
        | (.soft_after // [])[] | select(IN($d[])) | "\($s):\(.)"' <<<"$J"); do
      J="$(hold_once "$J" "${row%%:*}" "depends on dropped item ${row#*:} (soft)")"
    done
    for row in $(jq -r '.items[] | select(.status == "queued") | .slug as $s
        | .after[] | select(startswith("pr:")) | "\($s):\(.[3:])"' <<<"$J"); do
      [[ "$(pr_state "${row#*:}")" == CLOSED ]] \
        && J="$(hold_once "$J" "${row%%:*}" "depends on PR #${row#*:}, closed without merging")"
    done
    save "$J"
    jq -r '
      [.items[] | select(.status == "merged" or .status == "done") | .slug] as $met
      | ["STATUS", "SLUG", "ISSUE", "PR", "PANE", "WAITING ON", "HOLD"],
      (.items | sort_by(.status as $st | ["running", "at-bar", "merged", "queued", "done", "dropped"] | index($st))[]
       | [ .status + (if .held then " (held)" else "" end),
           .slug,
           (if .issue then "#\(.issue)" else "-" end),
           (if .pr.number then "#\(.pr.number)" else "-" end),
           (.pane.name // "-"),
           ([ (if .status == "queued" then .after[] else empty end),
              (if .status | IN("queued", "running", "at-bar")
               then (.soft_after // [])[] | select(IN($met[]) | not) | "\(.) (soft)" else empty end) ]
            | if length > 0 then join(",") else "-" end),
           (if .held then (.hold_reasons | join("; ")) else "-" end) ])
      | @tsv' <<<"$J" | column -t -s $'\t'
    ;;

  *) usage "unknown command '$CMD'" ;;
esac
