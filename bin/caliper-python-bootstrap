#!/usr/bin/env bash
set -euo pipefail

# caliper-python-bootstrap <dir>
#
# Build <dir>/.venv from <dir>'s Python manifests: an editable `.[dev]` install
# for a pyproject.toml with a [project] table, then `-r requirements.txt`. uv
# when it's on PATH, else `python3 -m venv` + the venv's pip. An existing .venv
# is reused, so both manifests land in one environment. No manifest: no-op.
#
# Used by dependency-bootstrap (feature/phase worktrees) and by
# caliper-phase-dispatch (issue #337): a task worktree nested in the parent
# can't share the parent's .venv, because its editable install points imports
# at the parent's source, not the task's.
#
# A venv this run creates gets a `*` .gitignore (uv writes one itself; Python
# < 3.13's venv doesn't), so it never shows as untracked content: that would
# block a no-force `git worktree remove` and invite a `git add -A` commit.

[[ $# -eq 1 ]] || { echo "Usage: caliper-python-bootstrap <dir>" >&2; exit 1; }
[[ -d "$1" ]] || { echo "ERROR: not a directory: $1" >&2; exit 1; }
cd "$1"

installs=()
if [[ -f pyproject.toml ]] && grep -q '^\[project\]' pyproject.toml; then
  installs+=("-e .[dev]")
fi
[[ -f requirements.txt ]] && installs+=("-r requirements.txt")
if (( ${#installs[@]} == 0 )); then
  echo "caliper-python-bootstrap: no Python manifest in $PWD; nothing to do" >&2
  exit 0
fi

# An inherited VIRTUAL_ENV (an activated parent venv) must not catch the
# install: uv pip honors it over ./.venv, so the target is always named.
unset VIRTUAL_ENV
have_uv=0
command -v uv >/dev/null 2>&1 && have_uv=1

if [[ ! -d .venv ]]; then
  if (( have_uv )); then uv venv .venv; else python3 -m venv .venv; fi
  [[ -e .venv/.gitignore ]] || echo '*' > .venv/.gitignore
fi

for spec in "${installs[@]}"; do
  read -r flag arg <<<"$spec"
  if (( have_uv )); then
    uv pip install --python .venv/bin/python "$flag" "$arg"
  else
    .venv/bin/pip install "$flag" "$arg"
  fi
done
