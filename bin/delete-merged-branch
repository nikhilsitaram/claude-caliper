#!/usr/bin/env bash
set -euo pipefail

# delete-merged-branch <branch> [<pr-ref>]
#
# Delete the local branch <branch> once GitHub reports its PR merged — pr-merge
# Step 3's containment guard (#285). <pr-ref> is what `gh pr view` resolves
# (default: <branch>); pass the PR number when known, since a reused name like
# phase-a resolves to its most recent PR, which may be a stale historical one.
#
# GitHub's MERGED state confirms the PR landed, but `update-ref -d` is as
# unconditional as `branch -D` (used over `branch -d` only because -d's merge
# check false-negatives on squash), so the local check gh can't make lives
# here: delete only when the local tip is exactly what GitHub merged
# (headRefOid), an ancestor of the merge commit (true merge), or tree-identical
# to it (squash/rebase). The headRefOid leg needs no fetched object and is
# immune to base movement, so a deferred run stays correct after other PRs land.
# Every leg is fail-closed: a failed gh lookup, an absent or diverged local
# tip, an unfetched merge commit, or a branch still checked out in a worktree
# (update-ref would orphan it) all leave the branch alone. The delete passes
# the tip the guard read as update-ref's expected old value, so it refuses if
# the branch moved in between.
#
# Exit 0 prints `DELETED <branch> <headRefOid>` (no oid if gh omitted it): the
# caller's cue for the remote delete, leased on that oid. Exit 2 prints one
# GONE/SKIP line saying why the branch was left in place. Exit 1 is a usage
# error. The remote branch stays with the caller so a safety hook can see the
# push. This is a script, not skill markdown, because the worktree-isolation
# guard refuses the inline form (gh #295).

usage() {
  echo "Usage: delete-merged-branch <branch> [<pr-ref>]" >&2
  exit 1
}

[[ $# -ge 1 && $# -le 2 ]] || usage
B="$1"
PR_REF="${2:-$1}"
git check-ref-format "refs/heads/$B" || usage

info="$(gh pr view "$PR_REF" --json state,mergeCommit,headRefOid 2>/dev/null)" || info=""
state="$(jq -r '.state // ""' <<<"$info" 2>/dev/null)" || state=""
if [[ "$state" != "MERGED" ]]; then
  echo "SKIP $B: gh state ${state:-unknown}, not MERGED — branch kept"
  exit 2
fi
head_oid="$(jq -r '.headRefOid // ""' <<<"$info")"
merge_oid="$(jq -r '.mergeCommit.oid // ""' <<<"$info")"

local_oid="$(git rev-parse --verify --quiet "refs/heads/$B")" || local_oid=""
if [[ -z "$local_oid" ]]; then
  echo "GONE $B: local branch already deleted"
  exit 2
fi
if [[ -z "$head_oid$merge_oid" ]]; then
  echo "SKIP $B: gh MERGED but headRefOid/mergeCommit.oid unavailable (gh lookup failed) — delete refs/heads/$B manually if intended"
  exit 2
fi

wt="$(git worktree list --porcelain | awk -v b="branch refs/heads/$B" '/^worktree /{w=substr($0,10)} $0==b{print w; exit}')"
if [[ -n "$wt" ]]; then
  echo "SKIP $B: still checked out in worktree $wt — remove it (or run git worktree prune if the directory is gone) first"
  exit 2
fi

contained() {
  [[ -n "$head_oid" && "$local_oid" == "$head_oid" ]] && return 0
  [[ -n "$merge_oid" ]] || return 1
  git merge-base --is-ancestor "$local_oid" "$merge_oid" 2>/dev/null && return 0
  git diff --quiet "$local_oid" "$merge_oid" 2>/dev/null
}
if ! contained; then
  echo "SKIP $B: gh MERGED but local tip is neither what GitHub merged nor contained in the merge commit (diverged) — delete refs/heads/$B manually if intended"
  exit 2
fi

if ! git update-ref -d "refs/heads/$B" "$local_oid" 2>/dev/null; then
  echo "SKIP $B: local delete failed (ref moved or locked) — leave the remote branch intact"
  exit 2
fi
echo "DELETED $B${head_oid:+ $head_oid}"
