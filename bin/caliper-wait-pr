#!/usr/bin/env bash
set -euo pipefail

# caliper-wait-pr <pr> [--merged] [--timeout-min N] [--interval-s N]
#                      [--min-wait-s N] [--grace-s N] [--require-check NAME]...
#
# The CI wait shared by pr-review and pr-merge (gh #314). Hand-rolled gh loops
# hung silently in two ways: blocking on a bot comment that never came (bots
# may post nothing for a no-op push), and waiting on checks that never start
# because the PR conflicts with its base (GitHub can't build the merge ref, so
# pull_request workflows never run). So this waits on check completion only,
# never on comment content, and reads PR state then mergeability on every poll
# before the checks. State goes first because a merged PR reports mergeable
# UNKNOWN, and UNKNOWN is never taken as clean.
#
# By default it returns once every check has concluded. --merged keeps waiting
# past green checks until GitHub merges or closes the PR (pr-merge's wait after
# `gh pr merge --auto`). --require-check NAME counts NAME as pending until it
# registers, for a bot whose check appears late. --min-wait-s holds the
# proceed outcomes (0 and 4) until that many seconds in, so checks still
# registering after a fresh push aren't missed. Time is counted in slept
# intervals: polls run at 0, interval, 2*interval, … up to the timeout.
#
# Progress goes to stderr each poll; one reason line goes to stdout. Exit:
#   0 GREEN      every check concluded, none failed, PR mergeable
#   1 FAILED     a check failed or was cancelled (names printed)
#   2 CONFLICT   the PR conflicts with its base — rebase and push
#   3 TIMEOUT    still waiting at the timeout (prints on what)
#   4 NO_CHECKS  no check registered by --grace-s on a mergeable PR (no CI,
#                a paths filter, or a workflow that skips this base branch)
#   5 MERGED
#   6 CLOSED     closed without merging
#  64            usage error, or the PR can't be read on the first poll
# A gh failure after the first poll is retried, not fatal. This is a script,
# not skill markdown, because the worktree-isolation guard refuses inline
# polling loops.

usage() {
  echo "Usage: caliper-wait-pr <pr> [--merged] [--timeout-min N] [--interval-s N] [--min-wait-s N] [--grace-s N] [--require-check NAME]..." >&2
  exit 64
}

int_arg() {  # <flag> <value>
  [[ "$2" =~ ^[0-9]+$ ]] && return
  echo "caliper-wait-pr: $1 needs a non-negative integer, got '$2'" >&2
  usage
}

PR="" MERGED_MODE=false TIMEOUT_MIN=10 INTERVAL=30 MIN_WAIT=0 GRACE=120 REQUIRED='[]'
while [[ $# -gt 0 ]]; do
  case "$1" in
    --merged) MERGED_MODE=true; shift; continue ;;
    --timeout-min|--interval-s|--min-wait-s|--grace-s|--require-check) [[ $# -ge 2 ]] || usage ;;
    -*) usage ;;
    *) [[ -z "$PR" ]] || usage; PR="$1"; shift; continue ;;
  esac
  case "$1" in
    --timeout-min) int_arg "$1" "$2"; TIMEOUT_MIN=$2 ;;
    --interval-s) int_arg "$1" "$2"; INTERVAL=$2 ;;
    --min-wait-s) int_arg "$1" "$2"; MIN_WAIT=$2 ;;
    --grace-s) int_arg "$1" "$2"; GRACE=$2 ;;
    --require-check) [[ -n "$2" ]] || usage; REQUIRED="$(jq -c --arg n "$2" '. + [$n]' <<<"$REQUIRED")" ;;
  esac
  shift 2
done
[[ -n "$PR" ]] || usage
(( INTERVAL >= 1 )) || usage

MAX_POLLS=$(( TIMEOUT_MIN * 60 / INTERVAL + 1 ))
HOLD=$(( GRACE > MIN_WAIT ? GRACE : MIN_WAIT ))  # earliest NO_CHECKS
ERR_FILE="$(mktemp)"
trap 'rm -f "$ERR_FILE"' EXIT

finish() { echo "$2"; exit "$1"; }
progress() { DETAIL="$1"; echo "poll $poll/$MAX_POLLS (${t}s): $1" >&2; }

# One poll: exits via finish on a terminal state, else reports progress.
poll_once() {
  local view state mergeable merge_status checks n failed pending npending
  if ! view="$(gh pr view "$PR" --json state,mergeable,mergeStateStatus 2>"$ERR_FILE")"; then
    if (( poll == 1 )); then
      echo "caliper-wait-pr: cannot read PR $PR: $(head -1 "$ERR_FILE")" >&2
      exit 64
    fi
    progress "gh pr view failed ($(head -1 "$ERR_FILE")), retrying"
    return
  fi
  state="$(jq -r '.state // ""' <<<"$view" 2>/dev/null)" || state=""
  mergeable="$(jq -r '.mergeable // "UNKNOWN"' <<<"$view" 2>/dev/null)" || mergeable=UNKNOWN
  merge_status="$(jq -r '.mergeStateStatus // "UNKNOWN"' <<<"$view" 2>/dev/null)" || merge_status=UNKNOWN
  case "$state" in
    MERGED) finish 5 "MERGED: PR $PR has merged" ;;
    CLOSED) finish 6 "CLOSED: PR $PR was closed without merging" ;;
    OPEN) ;;
    *) progress "gh pr view returned no state, retrying"; return ;;
  esac
  if [[ "$mergeable" == CONFLICTING || "$merge_status" == DIRTY ]]; then
    finish 2 "CONFLICT: PR $PR conflicts with its base (mergeable=$mergeable, mergeStateStatus=$merge_status) — rebase and push; pull_request checks can't start until then"
  fi

  # gh exits non-zero with checks pending or failed, so judge by the output.
  checks="$(gh pr checks "$PR" --json name,state,bucket 2>"$ERR_FILE")" || true
  if ! jq -e 'type == "array"' <<<"$checks" >/dev/null 2>&1; then
    if ! grep -q 'no checks reported' "$ERR_FILE"; then
      progress "gh pr checks failed ($(head -1 "$ERR_FILE")), retrying"
      return
    fi
    checks='[]'
  fi
  n="$(jq 'length' <<<"$checks")"
  failed="$(jq -r '[.[] | select(.bucket == "fail" or .bucket == "cancel") | .name] | join(", ")' <<<"$checks")"
  [[ -z "$failed" ]] || finish 1 "FAILED: $failed"
  pending="$(jq -c --argjson req "$REQUIRED" \
    '[(.[] | select(.bucket == "pending") | .name), (($req - map(.name))[] | "\(.) (not registered)")]' <<<"$checks")"
  npending="$(jq 'length' <<<"$pending")"

  if (( n == 0 )); then
    if [[ "$mergeable" == MERGEABLE ]] && (( t >= HOLD )); then
      finish 4 "NO_CHECKS: no checks registered on PR $PR after ${t}s, and it is mergeable — no CI, a paths filter, or a workflow that skips this base branch"
    fi
    progress "no checks registered yet (mergeable=$mergeable)"
  elif (( npending > 0 )); then
    progress "$npending pending: $(jq -r 'join(", ")' <<<"$pending")"
  elif [[ "$MERGED_MODE" == true ]]; then
    progress "all $n checks concluded, PR still OPEN (mergeStateStatus=$merge_status)"
  elif [[ "$mergeable" != MERGEABLE ]]; then
    progress "all $n checks concluded, mergeability $mergeable — waiting for GitHub to compute it"
  elif (( t < MIN_WAIT )); then
    progress "all $n checks concluded, holding until --min-wait-s ${MIN_WAIT}s"
  else
    finish 0 "GREEN: all $n checks on PR $PR concluded, none failed"
  fi
}

DETAIL=""
for (( poll = 1; poll <= MAX_POLLS; poll++ )); do
  (( poll == 1 )) || sleep "$INTERVAL"
  t=$(( (poll - 1) * INTERVAL ))
  poll_once
done
finish 3 "TIMEOUT: still waiting after ${TIMEOUT_MIN}m — $DETAIL"
