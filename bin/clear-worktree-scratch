#!/usr/bin/env bash
set -euo pipefail

# clear-worktree-scratch <worktree-path>
#
# Prepare a caliper worktree for a bare (no --force) `git worktree remove`:
# sync its agent memory back to $MAIN_ROOT, then delete caliper's own untracked
# scratch — the seeded .claude/agent-memory/ and .claude/settings.local.json,
# plus document drafts in .caliper-draft/ (and the pre-#306 .claude/caliper-draft/).
# In repos that don't gitignore .claude/ that scratch is untracked content, so
# the remove refuses and the caller's stop-on-failure rule halts cleanup (issue
# #297). Only untracked, non-ignored files are deleted: tracked memory (repos
# that commit it) stays, and ignored files — including a draft dir caliper-draft
# has made self-ignoring — never block a remove. Removing the worktree is left
# to the caller.
#
# Paths resolve under the worktree, never the caller's cwd — callers run this
# from the main checkout or the integration worktree, which hold their own
# files at the same relative paths. Refuses the main checkout and any path
# that isn't a worktree root. If the sync fails or skips on a held lock,
# nothing is deleted: the worktree may hold the only copy of new memory.

usage() {
  echo "Usage: clear-worktree-scratch <worktree-path>" >&2
  exit 1
}

[[ $# -eq 1 ]] || usage

[[ -d "$1" ]] || { echo "ERROR: worktree path does not exist: $1" >&2; exit 1; }

# Own line so set -e stops on a non-repo path; nested in the cd below, older
# bash would run `cd ""` as a no-op and clear the caller's cwd instead.
TOP="$(git -C "$1" rev-parse --show-toplevel)"
WORKTREE="$(cd "$TOP" && pwd -P)"

# Only a worktree root: a stray directory inside a worktree would otherwise
# resolve to the worktree containing it and clear that one instead.
if [[ "$(cd "$1" && pwd -P)" != "$WORKTREE" ]]; then
  echo "ERROR: not a worktree root: $1" >&2
  exit 1
fi

# A linked worktree's git dir is <common-dir>/worktrees/<name>; the main
# checkout's is the common dir itself, wherever it lives (--separate-git-dir,
# submodules), so compare the two rather than stripping a `/.git` suffix.
{ read -r GIT_DIR; read -r COMMON_DIR; } < <(git -C "$WORKTREE" rev-parse --path-format=absolute --git-dir --git-common-dir)
if [[ "$GIT_DIR" == "$COMMON_DIR" ]]; then
  echo "ERROR: refusing to clear scratch in the main checkout: $WORKTREE" >&2
  exit 1
fi

"$(dirname "$0")/sync-agent-memory" "$WORKTREE" || {
  echo "ERROR: sync-agent-memory failed; leaving $WORKTREE untouched" >&2
  exit 1
}

while IFS= read -r -d '' rel; do
  rm -f -- "$WORKTREE/$rel"
done < <(git -C "$WORKTREE" ls-files -z -o --exclude-standard -- \
  .claude/agent-memory .claude/caliper-draft .caliper-draft .claude/settings.local.json)
