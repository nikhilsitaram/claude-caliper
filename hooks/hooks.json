{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{
          "type": "command",
          "command": "bash",
          "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/pretooluse-deny-plan-md.sh"]
        }]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [{
          "type": "command",
          "command": "bash",
          "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/subagentstop-sync-agent-memory.sh"]
        }]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Edit|Write",
        "hooks": [{
          "type": "command",
          "command": "bash",
          "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/permission-request-accept-edits.sh"]
        }]
      }
    ]
  }
}
